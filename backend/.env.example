# ─── SECURITY ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ─── OAuth GitHub (criar em: github.com → Settings → Developer settings → OAuth Apps) ───
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OAuth Google (criar em: console.cloud.google.com → APIs e serviços → Credenciais) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── URLs OAuth ──────────────────────────────────────────────────
OAUTH_REDIRECT_BASE_URL=
FRONTEND_CALLBACK_URL=

# ─── EXTERNAL AI ─────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=
LLM_JSON_MODE=False
